@@ -2308,11 +2309,45 @@ bool PumpEvents() {
     SDL_PumpEvents();
     last_os_pump_ns = now_ns;
   }
+  static AntiAfk anti_afk = [] {
+    const char* value = GetEnvNonEmpty("MOCKTAIL_ANTI_AFK_SECONDS");
+    char* end = nullptr;
+    const unsigned long long seconds =
+        value != nullptr ? std::strtoull(value, &end, 10) : 0;
+    if (value != nullptr && (end == value || *end != '\0')) {
+      fprintf(stderr, "  [input] MOCKTAIL_ANTI_AFK_SECONDS=%s ignored\n",
+              value);
+      return AntiAfk(0);
+    }
+    if (seconds != 0) {
+      fprintf(stderr, "  [input] anti-AFK after %llus without input\n",
+              seconds);
+    }
+    return AntiAfk(static_cast<uint64_t>(seconds) * 1000000000ULL);
+  }();
+  if (g_state.sdl_window != nullptr &&
+      anti_afk.Due(SDL_GetTicksNS(), g_text_input_owner != nullptr &&
+                                         g_text_input_owner->active())) {
+    SDL_Event nudge{};
+    nudge.type = SDL_EVENT_MOUSE_MOTION;
+    nudge.motion.windowID = SDL_GetWindowID(g_state.sdl_window);
+    nudge.motion.xrel = 1.0f;
+    SDL_PushEvent(&nudge);
+    nudge.motion.xrel = -1.0f;
+    SDL_PushEvent(&nudge);
+    fprintf(stderr, "  [input] anti-AFK nudge\n");
+  }
   while (SDL_PeepEvents(&event, 1, SDL_GETEVENT, SDL_EVENT_FIRST,
                         SDL_EVENT_LAST) > 0) {
     if (event.type != SDL_EVENT_MOUSE_MOTION) {
       flush_motion();
     }
+    if (event.type == SDL_EVENT_KEY_DOWN ||
+        event.type == SDL_EVENT_MOUSE_BUTTON_DOWN ||
+        event.type == SDL_EVENT_MOUSE_WHEEL ||
+        (event.type == SDL_EVENT_MOUSE_MOTION && event.motion.which != 0)) {
+      anti_afk.OnInput(SDL_GetTicksNS());
+    }
     if (SdlEventTraceEnabled()) {
       fprintf(stderr, "  [window] SDL event type=%u\n", event.type);
     }
