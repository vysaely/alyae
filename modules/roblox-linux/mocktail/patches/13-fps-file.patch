+// Alyae: MOCKTAIL_FPS_FILE names a file; a frame-rate limit written there (1-1000, 0 for
+// uncapped) replaces the running game's DFIntTaskSchedulerTargetFps, which Mocktail set from
+// MOCKTAIL_FRAME_RATE_LIMIT at start, so an account's cap changes without a restart (the
+// clamps raised above let it pass 240). Read once a second. The flag is written only while it
+// still holds the last target Mocktail set (the start limit, then each one written): a
+// different value means its storage was not found right, or Roblox changed it.
+static void ApplyLiveFrameRateLimit(uint64_t now_ns) {
+  static const char* const path = [] {
+    const char* value = std::getenv("MOCKTAIL_FPS_FILE");
+    return value != nullptr && value[0] != '\0' ? value : nullptr;
+  }();
+  static uint64_t checked_ns = 0;
+  if (path == nullptr ||
+      (checked_ns != 0 && now_ns - checked_ns < 1000000000ULL)) {
+    return;
+  }
+  checked_ns = now_ns;
+  std::ifstream in(path);
+  char buffer[32] = {};
+  in.read(buffer, sizeof(buffer));
+  const std::string text(buffer, static_cast<std::size_t>(in.gcount()));
+  static std::string last_text;
+  if (text == last_text) {
+    return;
+  }
+  last_text = text;
+  const std::optional<int> wanted =
+      mocktail::runtime::ParseLiveFrameRateLimit(text);
+  if (!wanted) {
+    std::cout << "  [runtime] MOCKTAIL_FPS_FILE: not a frame-rate limit (1-"
+              << mocktail::runtime::kLiveFrameRateMaximum
+              << ", 0 for uncapped); ignored\n"
+              << std::flush;
+    return;
+  }
+  static int current = [] {
+    const char* limit = std::getenv("MOCKTAIL_FRAME_RATE_LIMIT");
+    const mocktail::runtime::FrameRatePolicy policy =
+        mocktail::runtime::ParseFrameRatePolicy(limit != nullptr ? limit : "");
+    if (policy.mode == mocktail::runtime::FrameRateLimitMode::kFixed) {
+      return policy.fixed_fps;
+    }
+    return policy.mode == mocktail::runtime::FrameRateLimitMode::kUnlimited
+               ? mocktail::runtime::kMaximumSupportedRobloxSchedulerFps
+               : 0;
+  }();
+  if (*wanted == current) {
+    return;
+  }
+  if (current == 0) {
+    std::cout << "  [runtime] MOCKTAIL_FPS_FILE needs MOCKTAIL_FRAME_RATE_LIMIT "
+                 "set to a number or unlimited at start; ignored\n"
+              << std::flush;
+    return;
+  }
+  static int32_t* const value = reinterpret_cast<int32_t*>(
+      FindTaskSchedulerTargetFpsValue(LibRobloxMappings()));
+  const int32_t held =
+      value != nullptr ? __atomic_load_n(value, __ATOMIC_RELAXED) : 0;
+  if (value == nullptr || held != current) {
+    std::cout << "  [runtime] MOCKTAIL_FPS_FILE: TaskSchedulerTargetFps "
+              << (value == nullptr ? "not located"
+                                   : "holds " + std::to_string(held) +
+                                         ", not " + std::to_string(current))
+              << "; limit left at " << current << '\n'
+              << std::flush;
+    return;
+  }
+  __atomic_store_n(value, *wanted, __ATOMIC_RELAXED);
+  std::cout << "  [runtime] frame-rate limit " << current << " -> " << *wanted
+            << " (MOCKTAIL_FPS_FILE)\n"
+            << std::flush;
+  current = *wanted;
+}
