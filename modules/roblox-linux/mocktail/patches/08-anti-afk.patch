diff --git a/tests/anti_afk_test.cc b/tests/anti_afk_test.cc
new file mode 100644
index 0000000..6cefda4
--- /dev/null
+++ b/tests/anti_afk_test.cc
@@ -0,0 +1,36 @@
+#include "window/anti_afk.h"
+
+#include <gtest/gtest.h>
+
+namespace mocktail::window {
+namespace {
+
+constexpr uint64_t kSecond = 1000000000ULL;
+
+TEST(AntiAfkTest, OffWithoutAnInterval) {
+  AntiAfk afk(0);
+  EXPECT_FALSE(afk.Due(1, false));
+  EXPECT_FALSE(afk.Due(3600 * kSecond, false));
+}
+
+TEST(AntiAfkTest, NudgesAnUntouchedAccountAfterTheInterval) {
+  AntiAfk afk(720 * kSecond);
+  EXPECT_FALSE(afk.Due(1 * kSecond, false));  // launch starts the clock
+  EXPECT_FALSE(afk.Due(700 * kSecond, false));
+  EXPECT_TRUE(afk.Due(722 * kSecond, false));
+  EXPECT_FALSE(afk.Due(723 * kSecond, false));  // restarted
+  EXPECT_TRUE(afk.Due(1443 * kSecond, false));
+}
+
+TEST(AntiAfkTest, InputAndTypingPostponeTheNudge) {
+  AntiAfk afk(720 * kSecond);
+  afk.Due(1 * kSecond, false);
+  afk.OnInput(600 * kSecond);
+  EXPECT_FALSE(afk.Due(1000 * kSecond, false));
+  EXPECT_FALSE(afk.Due(1400 * kSecond, true));  // typing: never nudged
+  EXPECT_FALSE(afk.Due(2000 * kSecond, false));
+  EXPECT_TRUE(afk.Due(2121 * kSecond, false));
+}
+
+}  // namespace
+}  // namespace mocktail::window
