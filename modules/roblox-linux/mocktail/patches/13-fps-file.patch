+// Alyae: what an account's MOCKTAIL_FPS_FILE may hold.
+TEST(FrameRatePolicyTest, ParsesLiveFrameRateLimit) {
+  EXPECT_EQ(ParseLiveFrameRateLimit("1"), 1);
+  EXPECT_EQ(ParseLiveFrameRateLimit("144\n"), 144);
+  EXPECT_EQ(ParseLiveFrameRateLimit("  60 \r\n"), 60);
+  EXPECT_EQ(ParseLiveFrameRateLimit("1000"), 1000);
+  EXPECT_EQ(ParseLiveFrameRateLimit("0\n"), kLiveFrameRateMaximum);
+  for (std::string_view rejected :
+       {"", "\n", "1001", "-1", "+5", "60fps", "6 0", "unlimited", "1.5",
+        "99999999999"}) {
+    EXPECT_FALSE(ParseLiveFrameRateLimit(rejected).has_value()) << rejected;
+  }
+}
