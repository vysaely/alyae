+std::string DeviceTrackerFromCookieFile(std::string_view text) {
+  constexpr std::string_view kName = "RBXEventTrackerV2=";
+  while (!text.empty()) {
+    const std::size_t end = text.find('\n');
+    std::string_view line = text.substr(0, end);
+    text = end == std::string_view::npos ? std::string_view() : text.substr(end + 1);
+    if (line.substr(0, kName.size()) != kName) continue;
+    line.remove_prefix(kName.size());
+    while (!line.empty() && (line.back() == '\r' || line.back() == ' ')) line.remove_suffix(1);
+    return line.size() > 512 ? std::string() : std::string(line);
+  }
+  return {};
+}
