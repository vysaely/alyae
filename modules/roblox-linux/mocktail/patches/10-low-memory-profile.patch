+// Alyae: MOCKTAIL_LOW_MEMORY_PROFILE=0 (a main) drops the phone settings and keeps the threading
+// entries; unset (an alt) keeps them all.
+TEST(PerformancePolicyTest, LowMemoryProfileCanBeTurnedOff) {
+  constexpr const char* kDesktopDefaults[] = {
+      "FIntRenderTextureMipBias",
+      "FIntLuaGcMaxKb",
+      "FIntLuauGcStepMul",
+      "FIntLuauGcGoalCore",
+      "FIntLuauGcStartupWorkingSetMb",
+      "FIntLuauGcStepMultiplier",
+      "FIntLuauGcGoalRatio",
+      "FFlagLuauStartupGcSuppression",
+      "FIntTaskSchedulerMaxTempArenaSizeBytes",
+      "FIntTerrainArraySliceSize",
+      "FFlagDebugTerrainVTCompressedTextures",
+      "FFlagMeshCompression",
+      "FFlagPhysicsMeshCompression",
+      "FFlagMeshLodApplyGeomMeshOptimizer",
+      "FIntNetworkStreamingGCMaxMicroSecondLimit",
+  };
+  std::string merged;
+  std::string error;
+  ASSERT_EQ(unsetenv("MOCKTAIL_LOW_MEMORY_PROFILE"), 0);
+  ASSERT_TRUE(MergePerformanceClientSettingsOverrides({true, 14}, "{}", &merged, &error))
+      << error;
+  nlohmann::json parsed = nlohmann::json::parse(merged, nullptr, false, true);
+  EXPECT_EQ(parsed.at("FIntRenderTextureTotalBudgetMB"), "128");
+  EXPECT_EQ(parsed.at("FFlagEnableSLIMAvatars"), "True");
+  EXPECT_EQ(parsed.at("FIntRenderTextureMipBias"), "1");
+  for (const char* name : kDesktopDefaults) {
+    EXPECT_TRUE(parsed.contains(name)) << name;
+  }
+
+  ASSERT_EQ(setenv("MOCKTAIL_LOW_MEMORY_PROFILE", "0", 1), 0);
+  ASSERT_TRUE(MergePerformanceClientSettingsOverrides({true, 14}, "{}", &merged, &error))
+      << error;
+  ASSERT_EQ(unsetenv("MOCKTAIL_LOW_MEMORY_PROFILE"), 0);
+  parsed = nlohmann::json::parse(merged, nullptr, false, true);
+  EXPECT_FALSE(parsed.contains("FIntRenderTextureTotalBudgetMB"));
+  EXPECT_FALSE(parsed.contains("FIntDefaultMeshCacheSizeMB"));
+  EXPECT_FALSE(parsed.contains("FFlagEnableSLIMAvatars"));
+  EXPECT_FALSE(parsed.contains("FIntProjectedMaxBytesUsedForSoundsMB"));
+  EXPECT_FALSE(parsed.contains("FIntAssetProviderAssetCacheReadThreadCount"));
+  EXPECT_EQ(parsed.at("FIntSmoothClusterTaskQueueMaxParallelTasks"), "14");
+  EXPECT_EQ(parsed.at("FFlagCurlUsePools"), "True");
+  for (const char* name : kDesktopDefaults) {
+    EXPECT_FALSE(parsed.contains(name)) << name;
+  }
+}
