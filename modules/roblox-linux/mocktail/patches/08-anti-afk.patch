diff --git a/src/window/anti_afk.h b/src/window/anti_afk.h
new file mode 100644
index 0000000..fb07a65
--- /dev/null
+++ b/src/window/anti_afk.h
@@ -0,0 +1,48 @@
+#ifndef MOCKTAIL_WINDOW_ANTI_AFK_H_
+#define MOCKTAIL_WINDOW_ANTI_AFK_H_
+
+#include <cstdint>
+
+namespace mocktail {
+namespace window {
+
+// Roblox disconnects a player after 20 minutes without input. With
+// MOCKTAIL_ANTI_AFK_SECONDS set, the window layer nudges the pointer by one
+// pixel and back after that many seconds without keyboard or mouse input, so
+// an account left in a game stays connected. The idle clock starts at launch
+// (an account nobody touched is covered too) and pauses while a text box has
+// focus, where a nudge could disturb typing.
+class AntiAfk final {
+ public:
+  explicit AntiAfk(uint64_t interval_ns) : interval_ns_(interval_ns) {}
+
+  bool enabled() const { return interval_ns_ != 0; }
+
+  // Real keyboard or mouse input restarts the idle clock.
+  void OnInput(uint64_t now_ns) { last_input_ns_ = now_ns; }
+
+  // True when a nudge is due; the clock then restarts from `now_ns`.
+  bool Due(uint64_t now_ns, bool typing) {
+    if (!enabled()) {
+      return false;
+    }
+    if (last_input_ns_ == 0 || typing) {
+      last_input_ns_ = now_ns;
+      return false;
+    }
+    if (now_ns - last_input_ns_ < interval_ns_) {
+      return false;
+    }
+    last_input_ns_ = now_ns;
+    return true;
+  }
+
+ private:
+  uint64_t interval_ns_ = 0;
+  uint64_t last_input_ns_ = 0;
+};
+
+}  // namespace window
+}  // namespace mocktail
+
+#endif  // MOCKTAIL_WINDOW_ANTI_AFK_H_
