+std::optional<int> ParseLiveFrameRateLimit(std::string_view text) {
+  constexpr std::string_view kSpace = " \t\r\n";
+  const std::size_t first = text.find_first_not_of(kSpace);
+  if (first == std::string_view::npos) {
+    return std::nullopt;
+  }
+  text = text.substr(first, text.find_last_not_of(kSpace) - first + 1);
+  int fps = -1;
+  const auto parsed =
+      std::from_chars(text.data(), text.data() + text.size(), fps);
+  if (parsed.ec != std::errc() || parsed.ptr != text.data() + text.size() ||
+      fps < 0 || fps > kLiveFrameRateMaximum) {
+    return std::nullopt;
+  }
+  return fps == 0 ? kLiveFrameRateMaximum : fps;
+}
