diff --git a/src/window/window_pointer_capture_owner.cc b/src/window/window_pointer_capture_owner.cc
index 8bbd388..e4c7492 100644
--- a/src/window/window_pointer_capture_owner.cc
+++ b/src/window/window_pointer_capture_owner.cc
@@ -1,5 +1,6 @@
 #include "window/window_pointer_capture_owner.h"
 
+#include <SDL3/SDL_events.h>
 #include <SDL3/SDL_keyboard.h>
 #include <SDL3/SDL_mouse.h>
 #include <SDL3/SDL_video.h>
@@ -240,10 +241,22 @@ bool SdlPointerCaptureBackend::Apply(const PointerCaptureRequest& request) {
     }
     return false;
   }
+  const bool released = relative_mode_ && !request.relative_mode;
   relative_mode_ = request.relative_mode;
   if (!relative_mode_) {
     drag_start_.reset();
   }
+  if (released) {
+    // Alyae: leaving relative mode moves the pointer back and makes the motion that says so,
+    // then flushes queued motion, that one too. Roblox draws its own cursor where it last heard
+    // the pointer was, so without this it stays at the drag's end until the mouse moves.
+    SDL_Event sync{};
+    sync.type = SDL_EVENT_MOUSE_MOTION;
+    sync.motion.windowID = SDL_GetWindowID(window);
+    sync.motion.which = 0;
+    sync.motion.state = SDL_GetMouseState(&sync.motion.x, &sync.motion.y);
+    SDL_PushEvent(&sync);
+  }
   if (!request.relative_mode && !SDL_SetWindowMouseGrab(window, false)) return false;
   return request.cursor_visible ? SDL_ShowCursor() : SDL_HideCursor();
 }
