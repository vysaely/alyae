+// Alyae: the device identity line Alyae writes after .ROBLOSECURITY in MOCKTAIL_COOKIE_FILE.
+TEST(WebViewHelperPolicyTest, ReadsDeviceTrackerFromCookieFile) {
+  EXPECT_EQ(DeviceTrackerFromCookieFile(
+                ".ROBLOSECURITY=_|WARNING:secret\nRBXEventTrackerV2=CreateDate=1&rbxid=&browserid=42\n"),
+            "CreateDate=1&rbxid=&browserid=42");
+  EXPECT_EQ(DeviceTrackerFromCookieFile("RBXEventTrackerV2=browserid=7 \r\n"), "browserid=7");
+  EXPECT_EQ(DeviceTrackerFromCookieFile("RBXEventTrackerV2=browserid=7"), "browserid=7");
+  EXPECT_EQ(DeviceTrackerFromCookieFile(".ROBLOSECURITY=_|WARNING:secret\n"), "");
+  EXPECT_EQ(DeviceTrackerFromCookieFile("x RBXEventTrackerV2=browserid=7\n"), "");
+  EXPECT_EQ(DeviceTrackerFromCookieFile("RBXEventTrackerV2=\n"), "");
+  EXPECT_EQ(DeviceTrackerFromCookieFile("RBXEventTrackerV2=" + std::string(513, 'a')), "");
+  EXPECT_EQ(DeviceTrackerFromCookieFile("RBXEventTrackerV2=" + std::string(512, 'a')),
+            std::string(512, 'a'));
+}
